# Copy to .env for LOCAL runs only. Never commit .env.
# In GitHub Actions these come from repository secrets/variables instead.

# Contact e-mail sent to NCBI, Crossref, OpenAlex ("polite pool" identification).
RESEARCH_AGENT_CONTACT_EMAIL=you@example.org

# Optional: raises NCBI E-utilities limit from 3 to 10 requests/second.
NCBI_API_KEY=

# Optional but recommended: OpenAlex free key ($1/day budget instead of the shared $0.10/day per IP).
OPENALEX_API_KEY=

# Optional: Semantic Scholar enrichment key.
SEMANTIC_SCHOLAR_API_KEY=

# Optional, only if config/llm.yaml selects `provider: deepseek` (PAY-PER-USE API key).
DEEPSEEK_API_KEY=

# The Claude Code OAuth token is ONLY used inside GitHub Actions via the secret
# CLAUDE_CODE_OAUTH_TOKEN. Do not put it here. Keep ANTHROPIC_API_KEY unset.
